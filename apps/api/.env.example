# ---------------------------------------------------------------------------
# Idlib Smart Platform API — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# App
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Comma separated list of additional origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://idlib:idlib_dev_password@localhost:5432/idlib_smart_platform?schema=public

# Redis (sessions, OTP throttling, BullMQ queues)
REDIS_URL=redis://localhost:6379

# JWT
# Generate strong random secrets, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=replace-with-another-long-random-secret
# Set to your real apex domain in production, e.g. .idlib-smart.sy
COOKIE_DOMAIN=

# Google OAuth 2.0 (console.cloud.google.com > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Email / SMTP (GoDaddy Workspace Email or Microsoft 365 relay)
# GoDaddy SMTP: smtpout.secureserver.net, port 465 (SSL) or 587 (STARTTLS)
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=
SMTP_FROM_NAME=منصة إدلب الذكية
SMTP_FROM_EMAIL=no-reply@example.com

# OTP
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Rate limiting (requests per window per IP, global default; auth endpoints are stricter — see throttler config)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Emergency call number shown/dialed from the Complaints screen (admin-configurable)
EMERGENCY_NUMBER=5555

# File uploads
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_FILE_SIZE_MB=10

# Encryption key for at-rest encryption of sensitive fields (32 bytes, base64)
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Business account conversion fee (USD, informational — real payment gateway TBD by client)
BUSINESS_ACCOUNT_FEE_USD=10

# Logging
LOG_LEVEL=info
